<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArchCracker.Desktop.ViewModels"
        x:Class="ArchCracker.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="920" Height="620" MinWidth="760" MinHeight="520"
        Title="ArchCracker">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="16">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{Binding TitleText}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SubtitleText}" Opacity="0.7" />
        </StackPanel>

        <Border Grid.Row="1" Padding="16" CornerRadius="10" Background="{DynamicResource ThemeControlLowBrush}"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="{Binding KernelStatusText}" FontWeight="SemiBold" Grid.ColumnSpan="2" />
                <TextBlock Grid.Row="1" Text="{Binding ProductLabel}" Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductText}" />
                <TextBlock Grid.Row="2" Text="{Binding VersionLabel}" Opacity="0.7" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersionText}" />
                <TextBlock Grid.Row="3" Text="{Binding AbiLibraryLabel}" Opacity="0.7" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AbiText}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="10">
                <WrapPanel Orientation="Horizontal">
                    <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding CreateHandleLabel}" Command="{Binding CreateHandleCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding DestroyHandleLabel}" Command="{Binding DestroyHandleCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding ThemeLabel}" Command="{Binding ToggleThemeCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding LanguageLabel}" Command="{Binding ToggleLanguageCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding IntegrityText}" />
                <TextBlock Text="{Binding SidecarText}" />
                <TextBlock Text="{Binding HandleText}" />
                <TextBlock Text="{Binding ProgressText}" />
                <TextBlock Text="{Binding HitText}" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                           IsVisible="{Binding HasError}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Column="1" Padding="12" CornerRadius="8" Background="{DynamicResource ThemeControlLowBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LogLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Log}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding LibraryPathText}" Opacity="0.6" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
