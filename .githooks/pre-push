#!/bin/sh
# Reject local pushes to main. Server-side branch protection is intentionally
# not enabled; this guard applies only to clones where it is installed.

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            echo "pre-push: direct push to main is forbidden. Open a PR instead." >&2
            exit 1
            ;;
    esac
done

exit 0
